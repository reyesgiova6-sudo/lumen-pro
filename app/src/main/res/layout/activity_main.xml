<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <TextureView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <mx.lumen.camera.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/flashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#FFFFFFFF"
        android:clickable="false"
        android:focusable="false" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <mx.lumen.camera.IconView
            android:id="@+id/btnFlash"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:contentDescription="Flash" />

        <mx.lumen.camera.IconView
            android:id="@+id/btnTimer"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:contentDescription="Temporizador" />

        <TextView
            android:id="@+id/timerBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-14dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:text="3s"
            android:textColor="@color/accent"
            android:textSize="9sp"
            android:visibility="gone" />

        <mx.lumen.camera.IconView
            android:id="@+id/btnHist"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:contentDescription="Histograma" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:paddingStart="9dp"
            android:paddingTop="4dp"
            android:paddingEnd="9dp"
            android:paddingBottom="4dp"
            android:text=""
            android:textColor="@color/text"
            android:textSize="10sp" />

        <mx.lumen.camera.IconView
            android:id="@+id/btnSettings"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:contentDescription="Ajustes" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/manualPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="176dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.18"
                android:text="MANUAL"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wbInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:letterSpacing="0.08"
                android:text=""
                android:textColor="@color/text_dim"
                android:textSize="9sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnLockAe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="BLOQUEAR AE"
                android:textColor="@color/text"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/btnResetManual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="AUTO"
                android:textColor="@color/text_dim"
                android:textSize="9sp" />
        </LinearLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2">

            <mx.lumen.camera.SliderView
                android:id="@+id/sliderIso"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1" />

            <mx.lumen.camera.SliderView
                android:id="@+id/sliderShutter"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1" />

            <mx.lumen.camera.SliderView
                android:id="@+id/sliderFocus"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1" />

            <mx.lumen.camera.SliderView
                android:id="@+id/sliderWb"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1" />
        </GridLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingTop="2dp"
            android:paddingEnd="16dp"
            android:paddingBottom="2dp"
            android:text=""
            android:textColor="@color/accent"
            android:textSize="9sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/modeStrip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
        </HorizontalScrollView>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="104dp">

            <ImageView
                android:id="@+id/thumbnail"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="22dp"
                android:background="@drawable/bg_thumb"
                android:contentDescription="Última foto"
                android:scaleType="centerCrop" />

            <mx.lumen.camera.ShutterButton
                android:id="@+id/shutter"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_centerInParent="true" />

            <mx.lumen.camera.IconView
                android:id="@+id/btnFlip"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="22dp"
                android:contentDescription="Cambiar cámara" />
        </RelativeLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/processing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_processing"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/processingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.22"
            android:text="PROCESANDO"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/procBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/accent" />

        <TextView
            android:id="@+id/processingDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text=""
            android:textColor="@color/text_dim"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
